# Only set true for the reviewed production release at https://developerzhub.com.
# Local development and private previews should stay false.
SITE_INDEXABLE=false
# Public verification tokens supplied by the domain owner, if used.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Resend API key — required for MVP hero OTP emails (https://resend.com)
RESEND_API_KEY=
# Secret used to sign OTP tokens — set to a random 32+ char string in production
OTP_SECRET=
